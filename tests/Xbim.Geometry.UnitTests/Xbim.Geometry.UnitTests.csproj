<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Xbim.Geometry.Engine.Interop.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Xbim.Geometry.Engine\Xbim.Geometry.Engine.csproj" />
    <ProjectReference Include="..\..\src\Xbim.Geometry.Abstractions\Xbim.Geometry.Abstractions.csproj" />
  </ItemGroup>

  <!-- Copy native libraries from CMake build output after build -->
  <PropertyGroup>
    <NativeBuildConfig Condition="'$(NativeBuildConfig)' == ''">$(Configuration)</NativeBuildConfig>
    <NativeCmakeBuildDir Condition="'$(NativeBuildConfig)' == 'Debug'">build-debug</NativeCmakeBuildDir>
    <NativeCmakeBuildDir Condition="'$(NativeBuildConfig)' != 'Debug'">build</NativeCmakeBuildDir>
    <NativeBuildDir>$(MSBuildThisFileDirectory)..\..\src\Xbim.Geometry.Engine.Native\$(NativeCmakeBuildDir)\$(NativeBuildConfig)\</NativeBuildDir>
    <LinuxNativeDir>$(MSBuildThisFileDirectory)..\..\src\Xbim.Geometry.Engine\runtimes\linux-x64\native\</LinuxNativeDir>
  </PropertyGroup>

  <!-- Windows: copy DLLs from CMake build output -->
  <Target Name="CopyNativeDlls" AfterTargets="Build" Condition="Exists('$(NativeBuildDir)xbim_geometry_native.dll')">
    <PropertyGroup>
      <NativeOutputDir>$(TargetDir)runtimes\win-x64\native\</NativeOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <NativeDlls Include="$(NativeBuildDir)*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(NativeOutputDir)" />
    <Copy SourceFiles="@(NativeDlls)" DestinationFolder="$(NativeOutputDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied native DLLs to $(NativeOutputDir)" />
  </Target>

  <!-- Linux: copy .so files from cmake install output -->
  <Target Name="CopyNativeSo" AfterTargets="Build" Condition="Exists('$(LinuxNativeDir)libxbim_geometry_native.so')">
    <PropertyGroup>
      <NativeOutputDir>$(TargetDir)runtimes/linux-x64/native/</NativeOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <NativeSoFiles Include="$(LinuxNativeDir)*.so*" />
    </ItemGroup>
    <MakeDir Directories="$(NativeOutputDir)" />
    <Copy SourceFiles="@(NativeSoFiles)" DestinationFolder="$(NativeOutputDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied native .so files to $(NativeOutputDir)" />
  </Target>

</Project>
