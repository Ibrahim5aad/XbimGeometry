<Project>

  <!-- Copy native libraries from the cmake install staging directory after build.
       Source: src/Xbim.Geometry.Engine/runtimes/{rid}/native/
       Dest:   {OutputDir}/runtimes/{rid}/native/
       Skipped for Blazor WASM — native code is statically linked via NativeFileReference. -->
  <PropertyGroup>
    <NativeInstallDir>$(MSBuildThisFileDirectory)..\src\Xbim.Geometry.Engine\runtimes\</NativeInstallDir>
    <NativeRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</NativeRid>
    <NativeRid Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</NativeRid>
    <NativeRid Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-x64</NativeRid>
    <NativeSourceDir>$(NativeInstallDir)$(NativeRid)\native\</NativeSourceDir>
  </PropertyGroup>

  <Target Name="CopyNativeLibs" AfterTargets="Build"
          Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' != 'true' AND '$(NativeRid)' != '' AND Exists('$(NativeSourceDir)')">
    <ItemGroup>
      <NativeLibFiles Include="$(NativeSourceDir)*" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)runtimes\$(NativeRid)\native\" />
    <Copy SourceFiles="@(NativeLibFiles)" DestinationFolder="$(TargetDir)runtimes\$(NativeRid)\native\" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied native libraries to $(TargetDir)runtimes\$(NativeRid)\native\" />
  </Target>

</Project>
