<Project>

  <!-- Copy native libraries from CMake build output after build.
       NativeBuildConfig selects Debug or Release (default: match managed Configuration). -->
  <PropertyGroup>
    <NativeBuildConfig Condition="'$(NativeBuildConfig)' == ''">$(Configuration)</NativeBuildConfig>
    <NativeBuildDir>$(MSBuildThisFileDirectory)..\src\Xbim.Geometry.Engine.Native\build\$(NativeBuildConfig)\</NativeBuildDir>
    <LinuxNativeDir>$(MSBuildThisFileDirectory)..\src\Xbim.Geometry.Engine.Interop\runtimes\linux-x64\native\</LinuxNativeDir>
  </PropertyGroup>

  <!-- Windows: copy DLLs from CMake build output -->
  <Target Name="CopyNativeDlls" AfterTargets="Build" Condition="Exists('$(NativeBuildDir)xbim_geometry_native.dll')">
    <PropertyGroup>
      <NativeOutputDir>$(TargetDir)runtimes\win-x64\native\</NativeOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <NativeDlls Include="$(NativeBuildDir)*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(NativeOutputDir)" />
    <Copy SourceFiles="@(NativeDlls)" DestinationFolder="$(NativeOutputDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied native DLLs to $(NativeOutputDir)" />
  </Target>

  <!-- Linux: copy .so files from staged output -->
  <Target Name="CopyNativeSo" AfterTargets="Build" Condition="Exists('$(LinuxNativeDir)libxbim_geometry_native.so')">
    <PropertyGroup>
      <NativeOutputDir>$(TargetDir)runtimes/linux-x64/native/</NativeOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <NativeSoFiles Include="$(LinuxNativeDir)*.so*" />
    </ItemGroup>
    <MakeDir Directories="$(NativeOutputDir)" />
    <Copy SourceFiles="@(NativeSoFiles)" DestinationFolder="$(NativeOutputDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied native .so files to $(NativeOutputDir)" />
  </Target>

</Project>
