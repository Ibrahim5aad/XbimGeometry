@page "/"
@inject ViewerThemeService ThemeService

<XbimViewer @ref="_viewer" Style="width: 100%; height: 100dvh;">
    <FileLoaderPanel DemoModels="_demos" />
    <ViewerToolbar Items="_toolbarItems" Position="ToolbarPosition.Bottom" Alignment="ToolbarAlignment.Center" />
</XbimViewer>

@code {
    private XbimViewer _viewer = default!;
    private List<ToolbarItemBase> _toolbarItems = default!;
    private bool _isOrtho;

    private readonly List<DemoModel> _demos =
    [
        new() { Name = "Duplex House", Url = "models/duplex.wexbim", Description = "Two-storey residential building" },
    ];

    protected override void OnInitialized()
    {
        _toolbarItems =
        [
            new ToolbarButton
            {
                Icon = ViewerIcons.Home,
                Tooltip = "Fit all",
                OnClick = EventCallback.Factory.Create(this, async () => await _viewer.FitAllAsync())
            },
            new ToolbarSeparator(),
            new ToolbarToggle
            {
                Icon = ViewerIcons.Orthographic,
                ActiveIcon = ViewerIcons.Perspective,
                Tooltip = "Switch to orthographic",
                ActiveTooltip = "Switch to perspective",
                OnToggle = EventCallback.Factory.Create<bool>(this, async (ortho) =>
                {
                    _isOrtho = ortho;
                    await _viewer.SetProjectionAsync(ortho);
                })
            },
            new ToolbarSeparator(),
            new ToolbarToggle
            {
                Icon = ViewerIcons.Moon,
                ActiveIcon = ViewerIcons.Sun,
                Tooltip = "Switch to light theme",
                ActiveTooltip = "Switch to dark theme",
                OnToggle = EventCallback.Factory.Create<bool>(this, _ => ThemeService.Toggle())
            },
        ];
    }
}
