<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Xbim.Examples.Viewer.Views"
        x:Class="Xbim.Examples.Viewer.Views.MainWindow"
        Title="Xbim IFC Viewer"
        Width="1280" Height="720">

    <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="4">
            <Button x:Name="OpenButton"
                    Content="Open"
                    Click="OnOpenClick"
                    ToolTip.Tip="Open a .wexbim file" />
            <Button Content="Fit View"
                    Command="{Binding FitViewCommand}"
                    ToolTip.Tip="Reset camera to show the full scene" />
        </StackPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Padding="8,4">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12" />
        </Border>

        <!-- Product list sidebar -->
        <Border DockPanel.Dock="Left"
                Width="250"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,1,0">
            <views:ProductListView x:Name="ProductList" />
        </Border>

        <!-- Viewport (fills remaining space) -->
        <views:ViewportControl x:Name="Viewport" />
    </DockPanel>

</Window>
