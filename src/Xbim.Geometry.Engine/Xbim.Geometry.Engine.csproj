<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Title>Xbim Geometry Engine</Title>
    <Description>Cross-platform geometry engine for xBIM, backed by OpenCASCADE.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Xbim.Geometry.Engine</PackageId>
    <RootNamespace>Xbim.Geometry.Engine</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU1900;CS8600;CS8602;CS8603;CS8604;CS8618;CS8625;CS8714;CS8767</NoWarn>
  </PropertyGroup>

  <!-- Native library build output directories (set via CMake build) -->
  <PropertyGroup>
    <NativeBuildRoot>$(MSBuildThisFileDirectory)..\Xbim.Geometry.Engine.Native\</NativeBuildRoot>
    <NativeBuildConfig Condition="'$(NativeBuildConfig)' == ''">$(Configuration)</NativeBuildConfig>
    <NativeCmakeBuildDir Condition="'$(NativeBuildConfig)' == 'Debug'">build-debug</NativeCmakeBuildDir>
    <NativeCmakeBuildDir Condition="'$(NativeBuildConfig)' != 'Debug'">build</NativeCmakeBuildDir>
    <WinX64NativeDir>$(NativeBuildRoot)$(NativeCmakeBuildDir)\$(NativeBuildConfig)\</WinX64NativeDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xbim.Geometry.UnitTests, " />
    <InternalsVisibleTo Include="Xbim.Geometry.IntegrationTests, " />
    <InternalsVisibleTo Include="Xbim.Geometry.Benchmarks, " />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\xbim-toolkit-icon.png" Pack="True" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xbim.Geometry.Abstractions\Xbim.Geometry.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Readme.md">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <!--
    Native library packaging: two modes controlled by IncludeNativeRuntimeDependencies.

    CI pack (IncludeNativeRuntimeDependencies=true):
      Natives live in separate runtime NuGet packages. This package declares
      dependencies on them so NuGet resolves the correct runtimes/{rid}/native/ at build time.

    Local dev pack (default):
      Embeds native binaries directly from the CMake build output (single platform).
  -->

  <!-- CI pack: depend on per-platform native runtime packages -->
  <ItemGroup Condition="'$(IncludeNativeRuntimeDependencies)' == 'true'">
    <PackageReference Include="Xbim.Geometry.Engine.Native.runtime.win-x64" Version="$(Version)" PrivateAssets="none" />
    <PackageReference Include="Xbim.Geometry.Engine.Native.runtime.linux-x64" Version="$(Version)" PrivateAssets="none" />
  </ItemGroup>

  <!-- Local dev pack: embed Windows x64 native libraries from CMake build output -->
  <ItemGroup Condition="'$(IncludeNativeRuntimeDependencies)' != 'true' And Exists('$(WinX64NativeDir)xbim_geometry_native.dll')">
    <None Include="$(WinX64NativeDir)*.dll" Exclude="$(WinX64NativeDir)test_*.exe">
      <Pack>true</Pack>
      <PackagePath>runtimes/win-x64/native/</PackagePath>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- Local dev pack: embed Linux x64 native libraries from CMake build output -->
  <ItemGroup Condition="'$(IncludeNativeRuntimeDependencies)' != 'true' And Exists('$(NativeBuildRoot)build/Release/libxbim_geometry_native.so')">
    <None Include="$(NativeBuildRoot)build/Release/*.so*">
      <Pack>true</Pack>
      <PackagePath>runtimes/linux-x64/native/</PackagePath>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- Local dev: copy staged native libraries to output for project-reference consumers -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)runtimes\win-x64\native\xbim_geometry_native.dll')">
    <Content Include="$(MSBuildThisFileDirectory)runtimes\win-x64\native\**\*">
      <Link>runtimes\win-x64\native\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>false</Pack>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)runtimes/linux-x64/native/libxbim_geometry_native.so')">
    <Content Include="$(MSBuildThisFileDirectory)runtimes/linux-x64/native/**/*">
      <Link>runtimes/linux-x64/native/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>false</Pack>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!--
    Include buildTransitive .targets so consuming projects automatically get
    native libraries copied to their output directories.
  -->
  <ItemGroup>
    <None Include="buildTransitive\Xbim.Geometry.Engine.targets" Pack="true" PackagePath="buildTransitive\" Condition="Exists('buildTransitive\Xbim.Geometry.Engine.targets')" />
  </ItemGroup>

</Project>
